    <string name="onboarding_title_1">NaviTV ব্রাউজারে স্বাগতম</string>
    <string name="onboarding_message_1">আপনার রিমোট, কীবোর্ড বা মাউস দিয়ে অ্যান্ড্রয়েড টিভিতে ওয়েব ব্রাউজ করুন। বোতামগুলির মধ্যে এবং পৃষ্ঠার ভিতরে সরানোর জন্য ডি-প্যাড ব্যবহার করুন।</string>
    <string name="onboarding_title_2">মাউস এবং পয়ন্টার মোড</string>
