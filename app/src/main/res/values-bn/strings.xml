    <string name="onboarding_title_3">আপনার প্রিয়গুলো সংরক্ষণ করুন</string>
    <string name="onboarding_message_3">পৃষ্ঠা বুকমার্ক করতে তারকা বোতাম ব্যবহার করুন। টুলবার থেকে যেকোনো সময় সংরক্ষিত বুকমার্ক এবং ইতিহাস খুলুন।</string>
    <string name="onboarding_title_4">আপনি এখন প্রস্তুত</string>
    <string name="onboarding_message_4">ইতিহাস স্বয়ংক্রিয়ভাবে সংরক্ষিত হয়। আপনার হোমপেজ পরিবর্তন করতে, ওয়েবসাইটের বিজ্ঞাপন ব্লক করতে বা ডেটা মুছতে সেটিংস দেখুন।</string>
