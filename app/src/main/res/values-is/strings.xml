    <string name="onboarding_title_1">Velkomin í NaviTV Browser</string>
    <string name="onboarding_message_1">Vafraðu um vefinn á Android TV með fjarstýringunni, lyklaborðinu eða músinni. Notaðu D-padinn til að fara á milli hnappa og innan síðunnar.</string>
    <string name="onboarding_title_2">Músar- og bendilstilling</string>
    <string name="onboarding_message_2">Kveiktu á músarstillingu til að færa bendil með D-padinum og smella með OK. Tengdu USB eða Bluetooth mús hvenær sem er — hún virkar samstundis.</string>
    <string name="onboarding_title_3">Vistaðu uppáhalds síðurnar þínar</string>
    <string name="onboarding_message_3">Notaðu stjörnuhnappinn til að setja síður í bókamerki. Opnaðu vistuð bókamerki og feril hvenær sem er úr tækjastikunni.</string>
    <string name="onboarding_title_4">Allt til reiðu</string>
    <string name="onboarding_message_4">Ferill er vistaður sjálfkrafa. Farðu í Stillingar til að breyta heimasíðunni þinni, loka á auglýsingar eða hreinsa gögn.</string>
    <string name="rating_title">Líkar þér við NaviTV Browser?</string>
    <string name="rating_message">Ef þér líkar við appið, vinsamlegast gefðu því einkunn. Það hjálpar okkur að bæta það!</string>
