<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/focusableItemBackground"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="10dp">

    <!-- Card Row Icon -->
    <ImageView
        android:id="@+id/ivRowIcon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="14dp"
        android:contentDescription="@string/list_item_icon"
        android:scaleType="centerInside"
        app:srcCompat="@drawable/ic_nav_bookmark"
        app:tint="?attr/colorAccent" />

    <!-- Text Group (Vertical) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvRowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvRowUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp"
            android:singleLine="true"
            android:ellipsize="end" />

    </LinearLayout>

    <!-- Delete Button for TV remote navigation -->
    <ImageButton
        android:id="@+id/btnDeleteRow"
        style="@style/ToolbarIconButton"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginStart="8dp"
        android:padding="8dp"
        android:src="@drawable/ic_nav_delete"
        app:tint="?android:attr/textColorSecondary"
        android:contentDescription="@string/action_delete" />

</LinearLayout>
