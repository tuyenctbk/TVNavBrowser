<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutDonationBanner"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:background="?attr/overlayCardBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp"
    android:visibility="gone">

    <ImageView
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/ic_support_heart"
        android:contentDescription="@string/donation_banner_title" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/donation_banner_title"
            android:textColor="@color/accent"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/donation_banner_msg"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnBannerSupport"
        style="@style/ToolbarButton"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:focusable="true"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="@string/donation_banner_action"
        android:textSize="12sp" />

    <ImageButton
        android:id="@+id/btnBannerDismiss"
        style="@style/ToolbarIconButton"
        android:layout_marginStart="8dp"
        android:src="@drawable/ic_nav_fullscreen_exit"
        android:contentDescription="@string/donation_banner_dismiss" />

</LinearLayout>
