<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="false"
    android:focusableInTouchMode="false">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="12dp"
    android:background="?attr/overlayCardBackground"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header Title Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_support_heart"
            android:contentDescription="@string/donation_title" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDonationTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/donation_title"
                android:textColor="@color/accent"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDonationSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/donation_subtitle"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnCloseDonation"
            style="@style/ToolbarIconButton"
            android:src="@drawable/ic_nav_fullscreen_exit"
            android:contentDescription="@string/ai_summary_close" />
    </LinearLayout>

    <!-- Active Supporter Badge Header -->
    <LinearLayout
        android:id="@+id/layoutSupporterBadge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="#204CAF50"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_support_heart"
            app:tint="#4CAF50"
            android:contentDescription="@string/donation_active_supporter" />

        <TextView
            android:id="@+id/tvSupporterBadgeStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/donation_active_supporter_desc"
            android:textColor="#4CAF50"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Navigation Tabs for Donation Methods -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnTabPlay"
            style="@style/ToolbarButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:focusable="true"
            android:text="@string/donation_tab_google_play"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnTabPaypal"
            style="@style/ToolbarButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:focusable="true"
            android:text="@string/donation_tab_paypal"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnTabKofi"
            style="@style/ToolbarButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:focusable="true"
            android:text="@string/donation_tab_kofi"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Tab 1: Google Play Content -->
    <LinearLayout
        android:id="@+id/layoutPlayContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/donation_method_google_play"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical">

            <Button
                android:id="@+id/btnTier1"
                style="@style/ToolbarButton"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:focusable="true"
                android:text="@string/donation_tier_1" />

            <Button
                android:id="@+id/btnTier2"
                style="@style/ToolbarButton"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="8dp"
                android:focusable="true"
                android:text="@string/donation_tier_2" />

            <Button
                android:id="@+id/btnTier3"
                style="@style/ToolbarButton"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="8dp"
                android:focusable="true"
                android:text="@string/donation_tier_3" />
        </LinearLayout>
    </LinearLayout>

    <!-- Tab 2: PayPal Content (TV Widescreen Horizontal Layout) -->
    <LinearLayout
        android:id="@+id/layoutPaypalContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ivPaypalQr"
            android:layout_width="144dp"
            android:layout_height="144dp"
            android:background="#FFFFFF"
            android:padding="6dp"
            android:contentDescription="@string/donation_qr_scan_hint" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/donation_method_paypal"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/donation_paypal_desc"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnPreset3"
                    style="@style/ToolbarButton"
                    android:layout_width="68dp"
                    android:layout_height="38dp"
                    android:focusable="true"
                    android:text="@string/donation_preset_3" />

                <Button
                    android:id="@+id/btnPreset5"
                    style="@style/ToolbarButton"
                    android:layout_width="68dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:focusable="true"
                    android:text="@string/donation_preset_5" />

                <Button
                    android:id="@+id/btnPreset10"
                    style="@style/ToolbarButton"
                    android:layout_width="68dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:focusable="true"
                    android:text="@string/donation_preset_10" />
            </LinearLayout>

            <Button
                android:id="@+id/btnOpenPaypal"
                style="@style/ToolbarButton"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginTop="10dp"
                android:focusable="true"
                android:text="@string/donation_open_paypal" />
        </LinearLayout>
    </LinearLayout>

    <!-- Tab 3: Ko-fi Content (TV Widescreen Horizontal Layout) -->
    <LinearLayout
        android:id="@+id/layoutKofiContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ivKofiQr"
            android:layout_width="144dp"
            android:layout_height="144dp"
            android:background="#FFFFFF"
            android:padding="6dp"
            android:contentDescription="@string/donation_qr_scan_hint" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/donation_method_kofi"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/donation_qr_scan_hint"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnOpenKofi"
                style="@style/ToolbarButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:focusable="true"
                android:text="@string/donation_open_kofi" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
</ScrollView>