    <string name="onboarding_title_1">Vitajte v prehliadači NaviTV</string>
    <string name="onboarding_message_1">Prehliadajte web na Android TV pomocou ovládača, klávesnice alebo myši. Pomocou smerového ovládača sa pohybujte medzi tlačidlami a na stránke.</string>
