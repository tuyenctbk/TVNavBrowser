    <string name="onboarding_title_1">Vitajte v prehliadači NaviTV</string>
    <string name="onboarding_message_1">Prehliadajte web na Android TV pomocou ovládača, klávesnice alebo myši. Pomocou smerového ovládača sa pohybujte medzi tlačidlami a na stránke.</string>
    <string name="onboarding_title_2">Režim myši a ukazovateľa</string>
    <string name="onboarding_message_2">Zapnite režim myši pre pohyb ukazovateľa pomocou smerového ovládača a klikanie tlačidlom OK. Kedykoľvek pripojte USB alebo Bluetooth myš — bude fungovať okamžite.</string>
