<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/light_accent_soft" />
            <corners android:radius="14dp" />
            <stroke
                android:width="2.5dp"
                android:color="@color/light_accent" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/light_bg_url_bar" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1.5dp"
                android:color="@color/light_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1dp"
                android:color="@color/light_divider" />
        </shape>
    </item>
</selector>
