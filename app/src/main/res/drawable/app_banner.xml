<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background Gradient - Deep Navy Glassmorphism with Sleek Depth -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#1A2436"
                android:centerColor="#0E1624"
                android:endColor="#070A10"
                android:type="linear" />
            <corners android:radius="8dp" />
            <stroke
                android:width="1.5dp"
                android:color="#33FFC857" />
            <size
                android:width="320dp"
                android:height="180dp" />
        </shape>
    </item>

    <!-- Subtle Tech Cyber Grid & Ambient Glow -->
    <item>
        <vector
            android:width="320dp"
            android:height="180dp"
            android:viewportWidth="320"
            android:viewportHeight="180">
            <!-- Grid Lines -->
            <path
                android:fillColor="#06FFFFFF"
                android:pathData="M0,30h320v1h-320z M0,60h320v1h-320z M0,90h320v1h-320z M0,120h320v1h-320z M0,150h320v1h-320z" />
            <path
                android:fillColor="#06FFFFFF"
                android:pathData="M60,0v180h1v-180z M120,0v180h1v-180z M180,0v180h1v-180z M240,0v180h1v-180z" />

            <!-- Compass Aura Glow (Soft Gold Radial Impression) -->
            <path
                android:fillColor="#15FFC857"
                android:pathData="M74,90m-52,0a52,52 0 1,0 104,0a52,52 0 1,0 -104,0" />
            <path
                android:fillColor="#20FFC857"
                android:pathData="M74,90m-42,0a42,42 0 1,0 84,0a42,42 0 1,0 -84,0" />

            <!-- Diagonal Tech Accent Lines -->
            <path
                android:strokeColor="#18FFC857"
                android:strokeWidth="1.2"
                android:pathData="M260,0 L320,60" />
            <path
                android:strokeColor="#10FFC857"
                android:strokeWidth="1"
                android:pathData="M280,0 L320,40" />
            <path
                android:strokeColor="#25FFC857"
                android:strokeWidth="1.5"
                android:pathData="M0,140 L40,180" />
        </vector>
    </item>

    <!-- Compass Hero Emblem -->
    <item
        android:gravity="center_vertical|start"
        android:start="28dp"
        android:width="92dp"
        android:height="92dp">
        <vector
            android:width="108dp"
            android:height="108dp"
            android:viewportWidth="108"
            android:viewportHeight="108">
            <!-- Globe Longitude/Latitude Grid (Subtle Web Symbolism) -->
            <path
                android:strokeColor="#22FFFFFF"
                android:strokeWidth="1.2"
                android:pathData="M54,18c-19.88,0 -36,16.12 -36,36s16.12,36 36,36s36,-16.12 36,-36S73.88,18 54,18z"
                android:fillColor="@android:color/transparent" />
            <path
                android:strokeColor="#18FFFFFF"
                android:strokeWidth="1.0"
                android:pathData="M54,18c8,0 16,16.12 16,36s-8,36 -16,36s-16,-16.12 -16,-36S46,18 54,18z"
                android:fillColor="@android:color/transparent" />
            <path
                android:strokeColor="#18FFFFFF"
                android:strokeWidth="1.0"
                android:pathData="M18,54h72" />

            <!-- Compass Outer Ring Background & Stroke -->
            <path
                android:fillColor="#1AFFFFC8"
                android:pathData="M54,14c-22.09,0 -40,17.91 -40,40s17.91,40 40,40s40,-17.91 40,-40s-17.91,-40 -40,-40z" />
            <path
                android:strokeColor="#FFFFC857"
                android:strokeWidth="2.8"
                android:pathData="M54,21c-18.22,0 -33,14.78 -33,33s14.78,33 33,33s33,-14.78 33,-33S72.22,21 54,21z" />
            <path
                android:strokeColor="#55FFFFFF"
                android:strokeWidth="0.8"
                android:pathData="M54,26c-15.46,0 -28,12.54 -28,28s12.54,28 28,28s28,-12.54 28,-28S69.46,26 54,26z" />

            <!-- Cardinal Ticks -->
            <path android:strokeColor="#FFFFC857" android:strokeWidth="2" android:pathData="M54,21v4 M54,87v-4 M87,54h-4 M21,54h4" />

            <!-- North Beveled Needle (Vibrant Gold) -->
            <path android:fillColor="#FFFFC857" android:pathData="M54,27l-10,24l10,6z" />
            <path android:fillColor="#FFE6A819" android:pathData="M54,27l10,24l-10,6z" />

            <!-- South Beveled Needle (Silver Steel) -->
            <path android:fillColor="#FFB0C4DE" android:pathData="M54,81l10,-24l-10,-6z" />
            <path android:fillColor="#FF708090" android:pathData="M54,81l-10,-24l10,-6z" />

            <!-- Center Pivot with Glow -->
            <path
                android:fillColor="#FFFFFF"
                android:pathData="M54,51c1.66,0 3,1.34 3,3s-1.34,3 -3,3s-3,-1.34 -3,-3S52.34,51 54,51z" />
        </vector>
    </item>

