            <!-- Pill Text Dots / Bar Accent -->
            <path
                android:fillColor="#FFFFC857"
                android:pathData="M16,64h3v2h-3z M22,64h3v2h-3z" />
            <path
                android:fillColor="#E0E0E0"
                android:pathData="M30,62h2v6h-2z M35,62h5v1.5h-1.5v4.5h-2v-4.5h-1.5z M43,62h4.5v1.5h-2.5v1h2v1.5h-2v2h-2z M52,62h3l2,6h-2l-0.5,-1.5h-2l-0.5,1.5h-2z M60,62h2l1.5,4l1.5,-4h2v6h-2v-3.5l-1.5,3.5h-1l-1.5,-3.5v3.5h-2z M70,62h4.5v1.5h-2.5v1h2v1.5h-2v2h-2z M78,62h4v1.5h-2v4.5h-2z M85,62h2v6h-2z M90,62h4v6h-4z M98,62h2l2,4v-4h2v6h-2l-2,-4v4h-2z" />
