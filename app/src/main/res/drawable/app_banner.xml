            <path android:fillColor="#FFFFC857" android:pathData="M48,34h12.5v16h-12.5z M52,38v8h4.5v-8z" />
            <path android:fillColor="#FFFFC857" android:pathData="M66,34h3.8l2.5,9.5l2.5,-9.5h3.5l2.5,9.5l2.5,-9.5h3.8l-4.5,16h-4l-2,-9l-2,9h-4z" />
            <path android:fillColor="#FFFFC857" android:pathData="M92,34h12.5v3.8h-8.5v2.2h8.5v9.8h-12.5v-3.8h8.5v-2.2h-8.5z" />
            <path android:fillColor="#FFFFC857" android:pathData="M110,34v16h12.5v-3.8h-8.5v-2.4h7.8v-3.6h-7.8v-2.4h8.5v-3.8z" />
            <path android:fillColor="#FFFFC857" android:pathData="M128,34h8.5c3.2,0 5.2,2 5.2,4.5s-2.2,3.5-4.5,4l4.8,7.5h-4.8l-4.2,-7h-2v7h-4z M132,39h4c1.2,0 1.8,-0.6 1.8,-1.8s-0.6,-1.8-1.8,-1.8h-4z" />

            <!-- Pill Badge: TV & GAME EDITION (Capsule) -->
            <path
                android:fillColor="#22FFC857"
                android:pathData="M10,58h148a4,4 0 0,1 4,4v6a4,4 0 0,1 -4,4h-148a4,4 0 0,1 -4,-4v-6a4,4 0 0,1 4,-4z" />
            <path
                android:strokeColor="#40FFC857"
