            <path android:fillColor="#FFFFFF" android:pathData="M39,6h4.5l8.5,20h-4.5l-2,-5h-8.5l-2,5h-4.5z M39.5,17h6.5l-3.2,-8.5z" />
            <path android:fillColor="#FFFFFF" android:pathData="M60,6h4.5l6.5,20h-4.5l-4.2,-14.5l-4.2,14.5h-4.5z" />
            <path android:fillColor="#FFFFFF" android:pathData="M81,6h4.5v20h-4.5z" />
            <path android:fillColor="#FFFFFF" android:pathData="M92,6h17v4.2h-6.2v15.8h-4.5v-15.8h-6.3z" />
